# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Safety limits
# Monthly DM ceiling per workspace. Optional; defaults to 10000 when unset.
# A backstop against a runaway campaign, not a billing tier — going over
# Meta's own limits is what gets an Instagram account restricted.
MONTHLY_DM_LIMIT=10000

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>
# Optional sign-in allowlist, comma separated. Left empty, anyone who can
# receive a magic link gets an account and a workspace. Set this before
# verifying a sending domain in Resend, which is what currently keeps
# registration closed.
ALLOWED_LOGIN_EMAILS=

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token
